# Configuration du Chatbot RH & Santé
# Copiez ce fichier en .env et remplissez vos valeurs

# === API Groq ===
GROQ_API_KEY=your_groq_api_key_here

# === Base de données Oracle ===
DB_USER=pfe_chatbot
DB_PASSWORD=pfe2026
DB_DSN=127.0.0.1:1521/XE

# === Oracle Client (optionnel - auto-détecté si non défini) ===
# Windows : ORACLE_LIB_DIR=C:\instantclient_23_0
# Linux   : ORACLE_LIB_DIR=/opt/oracle/instantclient
# ORACLE_LIB_DIR=

# === Configuration LLM ===
# MODEL_NAME=llama-3.1-8b-instant
# TEMPERATURE=0.0
# MAX_TOKENS=500

# === Cache ===
# CACHE_SIZE=50

# === Logging ===
# LOG_LEVEL=INFO
# LOG_LEVEL=DEBUG
